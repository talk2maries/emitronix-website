    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:consent": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/cookie-consent-runtime.test.mjs",
    "test:google-zoho": "node --import tsx --test tests/google-zoho/*.test.ts",
    "migrate:google-zoho": "tsx scripts/migrate-google-zoho.ts",
    "verify:zoho": "tsx scripts/verify-zoho.ts",
    "verify:google-ads": "tsx scripts/verify-google-ads.ts",
    "conversion:dry-run": "tsx scripts/conversion-dry-run.ts",
