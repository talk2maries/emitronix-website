# Zoho CRM OAuth credentials for website contact form lead creation.
# Add real values only in server/deployment environment variables, never in Git.
ZOHO_CLIENT_ID="replace-with-zoho-client-id"
ZOHO_CLIENT_SECRET="replace-with-zoho-client-secret"
ZOHO_REFRESH_TOKEN="replace-with-zoho-refresh-token"

# Zoho data center defaults. Change only if the Zoho account uses another region.
ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
ZOHO_API_DOMAIN="https://www.zohoapis.com"

# Optional CRM settings.
ZOHO_CRM_MODULE="Leads"
ZOHO_LEAD_SOURCE="Website Contact Form"
