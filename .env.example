# Public site/origin settings. Use comma-separated exact HTTPS origins only.
NEXT_PUBLIC_SITE_URL=https://emitronix.ae
CONTACT_ALLOWED_ORIGINS=https://emitronix.ae,https://www.emitronix.ae
CONTACT_ALLOW_MISSING_ORIGIN=false
# Set true only when the production reverse proxy overwrites X-Forwarded-For.
TRUST_PROXY=false

# Zoho CRM OAuth (server only). ZOHO_ACCOUNTS_URL must match the organization
# data centre; the runtime uses api_domain returned by Zoho OAuth.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=
ZOHO_CRM_MODULE=Leads
ZOHO_LEADS_LAYOUT_ID=
ZOHO_DEALS_LAYOUT_ID=
ZOHO_LEAD_SOURCE=Website Contact Form
ZOHO_GOOGLE_ADS_LEAD_SOURCE=Advertisement
ZOHO_GOOGLE_ADS_SUB_SOURCE=Google Ads
# API-name overrides after `npm run verify:zoho` discovers real fields. The
# websiteSubmissionId mapping is required and must point to the 64+ character
# API-updatable Emitronix Lead ID field. Never place credentials in this JSON.
ZOHO_LEADS_FIELD_MAP_JSON={}
ZOHO_DEALS_FIELD_MAP_JSON={}

# HMAC secret used by the trusted Zoho custom function/gateway. Generate at
# least 32 random characters. A native unsigned Zoho webhook is not sufficient.
ZOHO_GOOGLE_WEBHOOK_SECRET=

# Durable integration ledger. In production use a persistent path outside the
# release directory, e.g. /var/lib/emitronix/google-zoho.sqlite.
GOOGLE_ZOHO_DB_PATH=storage/google-zoho.sqlite
GOOGLE_ZOHO_AUDIT_RETENTION_DAYS=400
GOOGLE_ZOHO_RETENTION_APPLY=false

# Google Data Manager API v1 / Enhanced Conversions for Leads (server only).
# Dry-run is the safe default; both switches must be changed for live uploads.
GOOGLE_CONVERSION_UPLOAD_MODE=dry-run
GOOGLE_CONVERSION_UPLOAD_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_DATA_MANAGER_CLIENT_ID=
GOOGLE_DATA_MANAGER_CLIENT_SECRET=
GOOGLE_DATA_MANAGER_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Data Manager does not require a developer token. Keep this blank unless the
# optional Google Ads API v25 reporting/configuration path is later approved.
GOOGLE_ADS_DEVELOPER_TOKEN=

# No milestone is enabled by default. Approved comma-separated values:
# qualified_lead,meeting_booked,quotation_submitted,deal_won
GOOGLE_CONVERSION_ENABLED_EVENTS=
GOOGLE_CONVERSION_ACTION_QUALIFIED_LEAD_ID=
GOOGLE_CONVERSION_ACTION_MEETING_BOOKED_ID=
GOOGLE_CONVERSION_ACTION_QUOTATION_SUBMITTED_ID=
GOOGLE_CONVERSION_ACTION_DEAL_WON_ID=
# Optional one-time real tagged test click used only with the explicit
# `npm run verify:google-ads -- --validate-only` command. Remove after testing.
GOOGLE_VERIFY_TEST_GCLID=

# Cookie consent admin and runtime storage.
COOKIE_ADMIN_PASSWORD=
COOKIE_ADMIN_TOKEN=
COOKIE_CONSENT_STORE_PATH=

# Website administration and protected local storage.
ADMIN_SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERS_PATH=
CAREERS_STORE_DIR=
INTERNAL_ORIGIN=

# Consent-gated analytics and marketing integrations.
NEXT_PUBLIC_GTM_ID=GTM-MSM8MPD6
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_COOKIE_ANALYTICS_SCRIPT_URLS=
NEXT_PUBLIC_COOKIE_MARKETING_SCRIPT_URLS=
NEXT_PUBLIC_COOKIE_FUNCTIONAL_SCRIPT_URLS=
NEXT_PUBLIC_COOKIE_PERFORMANCE_SCRIPT_URLS=
